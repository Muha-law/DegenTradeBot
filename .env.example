# --- Telegram ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Chat/channel id where calls get posted (use @userinfobot to find your own id,
# or add the bot to a channel as admin and use the channel's numeric id, e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=
# Your personal Telegram user id — only this user can run admin commands like /setfilter
ADMIN_USER_ID=
# Optional extra broadcast destinations for signals (comma separated), e.g.
# @yourchannel. Add the bot as a channel admin with "Post Messages" permission
# first — signals go to these plus TELEGRAM_CHAT_ID.
TELEGRAM_SIGNAL_CHANNELS=

# --- Chains to watch (comma separated): base,ethereum,bsc,arbitrum ---
CHAINS=base,ethereum

# --- RPC endpoints (WebSocket) ---
# Free public endpoints work to get started. Swap in Alchemy/Infura/QuickNode
# WSS urls here later if you need higher reliability/rate limits.
BASE_WSS_RPC=wss://base-rpc.publicnode.com
ETHEREUM_WSS_RPC=wss://ethereum-rpc.publicnode.com
BSC_WSS_RPC=wss://bsc-rpc.publicnode.com
ARBITRUM_WSS_RPC=wss://arbitrum-one-rpc.publicnode.com
ROBINHOOD_WSS_RPC=wss://feed.mainnet.chain.robinhood.com

# --- Optional: Etherscan API key (free tier) ---
# Powers deployer-history risk checks via the multichain Etherscan V2 API.
# Get one at https://etherscan.io/apis — leave blank to skip that risk factor.
ETHERSCAN_API_KEY=

# --- Optional: GoPlus Security API key ---
# token_security works unauthenticated at low volume; get an App Key + App
# Secret pair from https://console.gopluslabs.io if you get rate limited.
# The bot exchanges these for a short-lived access token itself.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# --- Optional: Groq API key (free tier), powers AI rug/scam pattern screening ---
# Get one free at https://console.groq.com/keys — leave blank to skip AI
# screening entirely (the rest of the bot works fine without it).
GROQ_API_KEY=

# --- Optional: OpenSea API key — required for NFT features (collection
# sniping, wallet copy-trading, NFT paper/real trading) ---
# Get one at https://docs.opensea.io/reference/api-keys — leave blank to
# keep NFT features fully disabled (the rest of the bot is unaffected).
OPENSEA_API_KEY=

# --- Real-fund trading: wallet private key ---
# NEVER share this value in chat. Paste it here yourself, directly in this
# file. Use a wallet dedicated to this bot, funded only with what you're
# fully prepared to lose — never your main wallet. Leave blank to keep
# real-fund trading disabled (paper trading is unaffected either way).
WALLET_PRIVATE_KEY=

# --- Real-fund trading: passcode lock ---
# Required before the Real Funds Trading menu/actions become accessible in
# the bot at all — set your own value. Leave blank to keep the Real Funds
# Trading section fully locked out (fails closed, not open).
REAL_TRADING_PASSCODE=

# How often (minutes) to refresh price on tokens we've already called
PRICE_UPDATE_INTERVAL_MINUTES=10
# How long (hours) to keep updating price on a called token before we stop
PRICE_UPDATE_WINDOW_HOURS=6
